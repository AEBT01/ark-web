{
  "manifest_version": 3,
  "name": "Ark Web Bridge",
  "version": "5.1.2",
  "description": "本地浏览器桥接：把标签页能力经 WebSocket 暴露给 127.0.0.1:9333 的 bridge-server",
  "permissions": [
    "tabs",
    "debugger",
    "storage",
    "scripting",
    "alarms",
    "tabGroups",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:9333/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ark Web Bridge"
  },
  "options_page": "options.html"
}

